# Database
DATABASE_URL="mysql://polyglotio_user:polyglotio_password@localhost:3307/polyglotio"
SHADOW_DATABASE_URL="mysql://polyglotio_user:polyglotio_password@127.0.0.1:3307/polyglotio_shadow"

# Server
PORT=3001
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:5173

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Object storage: aws_s3 (default) or r2. AWS_* variables remain compatible.
OBJECT_STORAGE_PROVIDER=aws_s3
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=your-bucket-name
OBJECT_STORAGE_ACCESS_KEY_ID=your-access-key-id
OBJECT_STORAGE_SECRET_ACCESS_KEY=your-secret-access-key
# Required for R2, omitted for AWS:
# OBJECT_STORAGE_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
OBJECT_STORAGE_UPLOAD_URL_TTL_SECONDS=600
OBJECT_STORAGE_DOWNLOAD_URL_TTL_SECONDS=3600

# OpenAI Configuration
# Optional when AGENT_TMUX_ENABLED=true for Agent CLI-supported text features.
# Current TTS and image extraction still need a real OpenAI key.
OPENAI_API_KEY=
# auto: OpenAI API first, fallback to Agent CLI on missing key or 401.
# openai: require OpenAI API. agent_cli: always use supported CLI capabilities.
AI_PROVIDER=auto
# Planned, not implemented yet: auto | openai | system. Current TTS is OpenAI.
# TTS_PROVIDER=auto
AGENT_TMUX_ENABLED=true
AGENT_CLI_TYPE=codex
AGENT_CLI_AUTH_MODE=login
AGENT_CLI_BATCH_TIMEOUT_MS=120000
