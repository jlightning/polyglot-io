# Database
DATABASE_URL="mysql://polyglotio_user:polyglotio_password@localhost:3307/polyglotio"
SHADOW_DATABASE_URL="mysql://polyglotio_user:polyglotio_password@127.0.0.1:3307/polyglotio_shadow"

# Server
PORT=3001
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:5173

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# AWS S3 Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET_NAME=your-s3-bucket-name

# OpenAI Configuration
# Optional only when AGENT_TMUX_ENABLED=true. Direct OpenAI features such as
# generated lessons and TTS still return 503 until a real key is configured.
OPENAI_API_KEY=
# auto: OpenAI API first, fallback to Agent CLI on missing key or 401.
# openai: require OpenAI API. agent_cli: always use supported CLI capabilities.
AI_PROVIDER=auto
AGENT_TMUX_ENABLED=true
AGENT_CLI_TYPE=codex
AGENT_CLI_AUTH_MODE=login
AGENT_CLI_BATCH_TIMEOUT_MS=120000
